{
  "name": "@usex/audit",
  "version": "0.0.0",
  "description": "A Cloudflare-style 8-stage vulnerability-discovery agent, driven by your Claude subscription through the Claude Agent SDK. Bun + TypeScript.",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "prompts",
    "schemas",
    "config"
  ],
  "bin": {
    "audit": "src/cli.ts"
  },
  "keywords": [
    "ai",
    "cli",
    "security-agent",
    "security",
    "agent",
    "vulnerability",
    "claude",
    "claude-agent-sdk",
    "bun"
  ],
  "author": {
    "name": "Ali Torki",
    "url": "https://github.com/ali-master",
    "email": "ali_4286@live.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ali-master/audit.git"
  },
  "bugs": {
    "url": "https://github.com/ali-master/audit/issues"
  },
  "homepage": "https://github.com/ali-master/audit#readme",
  "logo": "https://raw.githubusercontent.com/ali-master/audit/master/assets/logo.svg",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "auth-check": "bun run src/cli.ts auth-check",
    "test": "bun test",
    "release": "release-it",
    "test:types": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "preinstall": "bunx only-allow bun"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@types/node": "^25.9.3",
    "@types/update-notifier": "^6.0.8",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "prettier": "^3.8.4",
    "release-it": "^20.2.0",
    "update-notifier": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "ajv": "^8.20.0",
    "bunup": "^0.16.32",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0"
  },
  "packageManager": "bun@1.3.14",
  "changelog": {
    "labels": {
      "feature": "Features",
      "bug": "Bug fixes",
      "enhancement": "Enhancements",
      "docs": "Docs",
      "dependencies": "Dependencies",
      "type: code style": "Code style tweaks",
      "status: blocked": "Breaking changes",
      "breaking change": "Breaking changes"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
