# Generate with: claude setup-token
# Requires Claude Pro, Max, Team, or Enterprise subscription.
# Note: ANTHROPIC_API_KEY MUST be unset (or absent) — otherwise it takes
# precedence over OAuth and silently routes to metered API billing. Pass
# --allow-api-key (or AUDIT_ALLOW_API_KEY=1) to opt into metered billing.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: LLM gateway (OpenRouter / custom proxy). When ANTHROPIC_BASE_URL
# points away from anthropic.com AND ANTHROPIC_AUTH_TOKEN is set, the harness
# routes through the gateway instead of your subscription.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=anthropic/claude-sonnet-4-6
